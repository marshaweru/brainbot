{
  "name": "@brainbot/bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev": "tsx watch --no-check src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "build:all": "pnpm --filter @brainbot/shared build && pnpm --filter @brainbot/bot build",
    "prestart": "pnpm run build:all",
    "start": "node dist/index.js",
    "prompt:lesson": "tsx src/scripts/prompt-smoke.ts",
    "enrich:insights": "tsx src/scripts/enrich-insights.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brainbot/shared": "workspace:*",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.3.3",
    "puppeteer": "^24.20.0",
    "telegraf": "^4.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.17",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
