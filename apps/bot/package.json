{
  "name": "@brainbot/bot",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@9.10.0",
  "engines": { "node": ">=20.11.0" },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --no-check src/index.ts",
    "build": "tsc",
    "build:all": "pnpm -w -r --filter @brainbot/shared --filter @brainbot/bot build",
    "prestart": "pnpm run build:all",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brainbot/shared": "workspace:*",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.3.3",
    "puppeteer": "^24.20.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/puppeteer": "^5.4.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
