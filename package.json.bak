{
  "name": "brainbot-root",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run -ws build",
    "build:shared": "npm run -w @brainbot/shared build",
    "build:bot": "npm run build:shared && npm run -w apps/bot build",
    "build:admin": "npm run build:shared && npm run -w apps/admin build",

    "dev:web": "npm run dev --workspace=apps/web",
    "dev:bot": "npm run dev --workspace=apps/bot",
    "start:web": "npm run start --workspace=apps/web",
    "start:bot": "npm run start --workspace=apps/bot"
  }
}
