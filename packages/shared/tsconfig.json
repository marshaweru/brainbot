{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmitOnError": true,

    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",              // was ESNext
    "moduleResolution": "NodeNext",    // was Bundler
    "verbatimModuleSyntax": true,      // keep import/export as-is
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
