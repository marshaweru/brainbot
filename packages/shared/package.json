{
  "name": "@brainbot/shared",
  "version": "1.0.0",
  "private": true,

  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js",
      "require": "./dist/db/index.js"
    }
  },

  "files": ["dist"],
  "sideEffects": false,

  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist"
  },

  "peerDependencies": {
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.9.2",
    "mongodb": "6.8.0"
  },

  "engines": { "node": ">=20" }
}
