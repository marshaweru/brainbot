{
  "name": "@brainbot/shared",
  "version": "1.0.0",
  "private": true,

  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",

  "exports": {
    ".": {
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./db": {
      "require": "./dist/db/index.js",
      "default": "./dist/db/index.js",
      "types": "./dist/db/index.d.ts"
    }
  },

  "files": ["dist"],
  "sideEffects": false,

  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist"
  },

  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.9.2"
  },

  "engines": { "node": ">=20" }
}
