{
  "name": "brainbot-root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:bot": "npm run dev --workspace=apps/bot",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "start:web": "npm run start --workspace=apps/web",
    "start:bot": "npm run start --workspace=apps/bot",
    "backfill:link-expiry": "tsx apps/web/scripts/backfill-link-token-expiry.ts",
    "start:admin": "npm run start --workspace=apps/admin",
    "ts": "ts-node",
    "run:ts": "npx ts-node --loader ts-node/esm"
  },
  "type": "module",
  "dependencies": {
    "@sparticuz/chromium": "^138.0.2",
    "@types/mongodb": "^4.0.6",
    "dayjs": "^1.11.18",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "mongodb": "^6.19.0",
    "pdfkit": "^0.17.2",
    "puppeteer-core": "^24.20.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^24.4.0",
    "@types/pdfkit": "^0.17.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
